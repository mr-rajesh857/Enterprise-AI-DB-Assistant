# Root repo ignores for frontend and backend

# backend Python environments
/.venv/
/backend/.venv/
/backend/venv/

# backend Python caches and test artifacts
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# backend local config and data
/backend/.env
/backend/.env.*
/backend/app.db
/backend/*.db
/backend/*.db-journal
/backend/*.sqlite
/backend/*.sqlite3

# frontend dependencies and build output
/frontend/node_modules/
/frontend/.pnp
/frontend/.pnp.*
/frontend/.yarn/
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/coverage/
/frontend/.vercel/

# frontend env and generated types
/frontend/.env
/frontend/.env.*
/frontend/next-env.d.ts

# shared OS/editor/debug files
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# shared TypeScript build metadata
*.tsbuildinfo